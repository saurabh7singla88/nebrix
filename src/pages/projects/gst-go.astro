---
import Layout from '../../layouts/Layout.astro';

const features = [
  {
    title: 'Automatic Invoicing',
    desc: 'Generates GST-compliant invoices for every Shopify order — B2B, B2C, export, and reverse charge scenarios all handled automatically.',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M14 2v6h6M9 13h6M9 17h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
  },
  {
    title: 'Credit Notes & Returns',
    desc: 'When customers return orders, credit notes are generated automatically with correct GST reversal, linked to the original invoice.',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 14l-4-4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 10h11a4 4 0 010 8h-1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
  },
  {
    title: 'GSTR Reports',
    desc: 'One-click generation of GSTR-1 and GSTR-3B summaries, formatted and ready to upload directly to the GST portal.',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  },
  {
    title: 'HSN & Tax Breakdown',
    desc: 'Full support for HSN/SAC codes, CGST/SGST/IGST split, multi-tax slabs, and custom invoice templates for all business types.',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M7 8h10M7 12h7M7 16h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
  },
];


const stack = ['Next.js', 'React', 'Node.js', 'AWS DynamoDB', 'Shopify API', 'TypeScript', 'AWS Lambda'];
---

<Layout
  title="GST Go — Nebrix"
  description="GST-compliant invoicing and filing automation for Indian Shopify sellers."
>
  <div class="detail-page">
    <div class="container">

      <a href="/#projects" class="back-link">← All Projects</a>

      <!-- ── Hero ── -->
      <section class="d-hero">
        <div class="d-hero-meta">
          <span class="live-badge">Live</span>
          <span class="product-cat">Shopify App</span>
        </div>
        <h1 class="d-hero-name">GST Go</h1>
        <p class="d-hero-tagline">The ultimate GST app for Indian SMBs</p>
        <p class="d-hero-desc">
          Helps Indian Shopify sellers automate GST invoicing and simplify GST
          filing in one place — from compliant invoice generation to one-click
          GSTR reports ready for the GST portal.
        </p>
        <div class="d-hero-actions">
          <!-- TODO: Replace # with your Shopify App Store URL -->
          <a href="#" class="btn btn-primary" target="_blank" rel="noopener">
            View on Shopify App Store
          </a>
        </div>
      </section>

      <!-- ── Hero Screenshot ── -->
      <!--
        📸 ADD HERO SCREENSHOT
        1. Save your file at:  public/images/gst-go/hero.png  (recommended: 1440×900)
        2. Replace the <div class="img-ph large"> below with:
           <img src="/images/gst-go/hero.png" alt="GST Go dashboard" class="browser-img" />
      -->
      <div class="browser-frame">
        <div class="browser-bar">
          <span class="bdot"></span>
          <span class="bdot"></span>
          <span class="bdot"></span>
        </div>
        <div class="browser-body">
          <img src="/images/gst-go/invoice-page.jpg" alt="GST Go invoice page" class="browser-img" />
        </div>
      </div>

      <!-- ── Features ── -->
      <section class="d-section">
        <p class="d-label">Features</p>
        <h2 class="d-heading">What it does</h2>
        <div class="features-grid">
          {features.map(f => (
            <div class="feature-card">
              <div class="feature-icon" set:html={f.icon}></div>
              <h3 class="feature-title">{f.title}</h3>
              <p class="feature-desc">{f.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ── Screenshots ── -->
      <!--
        📸 ADD SCREENSHOTS
        For each slot below, save the image at the path shown in <code>, then replace
        the <div class="img-ph"> with: <img src="/images/gst-go/FILENAME" alt="LABEL" />
      -->
      <section class="d-section">
        <p class="d-label">Screenshots</p>
        <h2 class="d-heading">See it in action</h2>
        <div class="screenshots-grid">
          <figure class="shot-slot">
            <img src="/images/gst-go/gstr-reports.png" alt="GSTR Reports" />
            <figcaption class="shot-caption">GSTR Reports</figcaption>
          </figure>
          <figure class="shot-slot">
            <img src="/images/gst-go/hsn-page.png" alt="HSN Page" />
            <figcaption class="shot-caption">HSN Page</figcaption>
          </figure>
          <figure class="shot-slot">
            <img src="/images/gst-go/templates.png" alt="Invoice Templates" />
            <figcaption class="shot-caption">Invoice Templates</figcaption>
          </figure>
        </div>
      </section>

      <!-- ── Tech Stack ── -->
      <section class="d-section d-stack">
        <p class="d-label">Tech Stack</p>
        <div class="stack-pills">
          {stack.map(t => <span class="stack-pill">{t}</span>)}
        </div>
      </section>

      <div class="d-bottom">
        <a href="/#projects" class="back-link">← Back to Projects</a>
      </div>

    </div>
  </div>
</Layout>

<style>
  /* ── Page ── */
  .detail-page {
    padding-top: 60px;
    padding-bottom: 80px;
  }

  /* ── Back link ── */
  .back-link {
    display: inline-block;
    font-size: 13px;
    color: var(--text-2);
    padding: 32px 0 0;
    transition: color 0.15s;
  }
  .back-link:hover {
    color: var(--text-1);
  }

  /* ── Hero ── */
  .d-hero {
    padding: 56px 0 48px;
    max-width: 660px;
  }
  .d-hero-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .live-badge {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #4ade80;
    border: 1px solid rgba(74, 222, 128, 0.2);
    background: rgba(74, 222, 128, 0.07);
    padding: 3px 10px;
    border-radius: 100px;
  }
  .product-cat {
    font-size: 13px;
    color: var(--text-2);
  }
  .d-hero-name {
    font-size: clamp(48px, 7vw, 72px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.05;
    margin-bottom: 14px;
  }
  .d-hero-tagline {
    font-size: 18px;
    color: var(--text-2);
    font-weight: 500;
    margin-bottom: 16px;
  }
  .d-hero-desc {
    font-size: 15px;
    color: var(--text-2);
    line-height: 1.8;
    max-width: 520px;
    margin-bottom: 28px;
  }
  .d-hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ── Buttons ── */
  .btn {
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    font-weight: 500;
    padding: 10px 20px;
    border-radius: 8px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .btn-primary {
    background: #fff;
    color: #000;
    border-color: #fff;
  }
  .btn-primary:hover {
    opacity: 0.85;
  }

  /* ── Browser frame ── */
  .browser-frame {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 80px;
  }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  .bdot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    display: block;
  }
  .browser-body {
    position: relative;
  }
  :global(.browser-img) {
    width: 100%;
    display: block;
  }

  /* ── Image placeholder ── */
  .img-ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: var(--text-3);
    padding: 48px 24px;
    text-align: center;
  }
  .img-ph.large {
    padding: 96px 24px;
  }
  .img-ph p {
    font-size: 13px;
    color: var(--text-3);
  }
  .img-ph code {
    font-size: 11px;
    color: var(--text-3);
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: 4px;
    font-family: 'Menlo', 'Consolas', monospace;
  }

  /* ── Sections ── */
  .d-section {
    border-top: 1px solid var(--border);
    padding: 80px 0;
  }
  .d-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 12px;
  }
  .d-heading {
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 40px;
  }

  /* ── Features grid ── */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .feature-card {
    background: var(--surface);
    padding: 32px 28px;
    transition: background 0.15s;
  }
  .feature-card:hover {
    background: var(--surface-2);
  }
  .feature-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-hover);
    border-radius: 8px;
    color: var(--text-2);
    margin-bottom: 20px;
    flex-shrink: 0;
  }
  .feature-title {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }
  .feature-desc {
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.75;
  }
  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Screenshots grid ── */
  .screenshots-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .shot-slot {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .shot-slot .img-ph {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 40px 24px;
    flex: 1;
  }
  .shot-slot img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    display: block;
  }
  .shot-caption {
    font-size: 13px;
    color: var(--text-2);
    text-align: center;
  }
  @media (max-width: 860px) {
    .screenshots-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .screenshots-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Tech stack ── */
  .d-stack {
    padding-bottom: 0;
  }
  .stack-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .stack-pill {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-2);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 6px 14px;
    border-radius: 100px;
  }

  /* ── Bottom nav ── */
  .d-bottom {
    border-top: 1px solid var(--border);
    padding: 40px 0 0;
  }
  .d-bottom .back-link {
    padding-top: 0;
  }
</style>
