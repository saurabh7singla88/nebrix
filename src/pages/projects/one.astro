---
import Layout from '../../layouts/Layout.astro';

const features = [
  {
    title: 'Multi-workspace Tracking',
    desc: 'Organise initiatives, tasks, and notes across multiple teams and workstreams in one place — without losing context as you move between them.',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/></svg>',
  },
  {
    title: 'AI Analysis',
    desc: 'Intelligent summaries across your work — surface blockers early, identify patterns across initiatives, and get sharp recaps of what matters most.',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2a7 7 0 017 7c0 2.5-1.3 4.7-3.3 6L15 18H9l-.7-3A7 7 0 0112 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9 18h6M9.5 21h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
  },
  {
    title: 'Gmail Integration',
    desc: 'Connect your inbox to auto-capture meeting outcomes, decisions, and action items from email threads — keeping your tracker in sync with reality.',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M2 7l10 7 10-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
  },
  {
    title: 'JIRA & Confluence Sync',
    desc: 'Pull in tickets, epics, and wiki pages without leaving One. Link initiatives to JIRA issues and attach Confluence docs for full context in a single view.',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 3h6v6M14 10l7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M11 5H5a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2v-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
  },
];


const stack = ['Electron', 'React', 'Node.js', 'TypeScript', 'OpenAI API', 'Gmail API', 'Atlassian API'];
---

<Layout
  title="One — Nebrix"
  description="AI-powered initiative tracker and strategic management tool for engineering managers and VPs."
>
  <div class="detail-page">
    <div class="container">

      <a href="/#projects" class="back-link">← All Projects</a>

      <!-- ── Hero ── -->
      <section class="d-hero">
        <div class="d-hero-meta">
          <span class="beta-badge">Beta</span>
          <span class="product-cat">Desktop & Web App</span>
        </div>
        <h1 class="d-hero-name">One</h1>
        <p class="d-hero-tagline">AI-powered initiative tracker for engineering leaders</p>
        <p class="d-hero-desc">
          Strategic management tool built for engineering managers and VPs. Track
          projects, tasks, notes, and meeting outcomes across multiple workspaces
          — with AI analysis, Gmail integration, and JIRA/Confluence connectivity.
        </p>
        <div class="d-hero-actions">
          <!-- TODO: Replace # with your app/waitlist URL -->
          <a href="#" class="btn btn-primary">Join Waitlist</a>
          <div class="platform-row">
            <span class="platform-pill">
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <rect x="1" y="1" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
                <path d="M4 13h6M7 11v2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              </svg>
              macOS & Windows
            </span>
            <span class="platform-pill">
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.2"/>
                <path d="M7 1.5C7 1.5 5 4 5 7s2 5.5 2 5.5M7 1.5C7 1.5 9 4 9 7s-2 5.5-2 5.5M1.5 7h11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              </svg>
              Web App
            </span>
          </div>
        </div>
      </section>

      <!-- ── Hero Screenshot ── -->
      <!--
        📸 ADD HERO SCREENSHOT
        1. Save your file at:  public/images/one/hero.png  (recommended: 1440×900)
        2. Replace the <div class="img-ph large"> below with:
           <img src="/images/one/hero.png" alt="One dashboard" class="browser-img" />
      -->
      <div class="browser-frame">
        <div class="browser-bar">
          <span class="bdot"></span>
          <span class="bdot"></span>
          <span class="bdot"></span>
        </div>
        <div class="browser-body">
          <img src="/images/one/screenshot-1.png" alt="One — Initiative Dashboard" class="browser-img" />
        </div>
      </div>

      <!-- ── Features ── -->
      <section class="d-section">
        <p class="d-label">Features</p>
        <h2 class="d-heading">What it does</h2>
        <div class="features-grid">
          {features.map(f => (
            <div class="feature-card">
              <div class="feature-icon" set:html={f.icon}></div>
              <h3 class="feature-title">{f.title}</h3>
              <p class="feature-desc">{f.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ── Screenshots ── -->
      <!--
        📸 ADD SCREENSHOTS
        For each slot below, save the image at the path shown in <code>, then replace
        the <div class="img-ph"> with: <img src="/images/one/FILENAME" alt="LABEL" />
      -->
      <section class="d-section">
        <p class="d-label">Screenshots</p>
        <h2 class="d-heading">See it in action</h2>
        <div class="screenshots-grid">
          <figure class="shot-slot">
            <img src="/images/one/screenshot-2.png" alt="AI Summary View" />
            <figcaption class="shot-caption">AI Summary View</figcaption>
          </figure>
          <figure class="shot-slot">
            <img src="/images/one/screenshot-3.png" alt="Mindmap View" />
            <figcaption class="shot-caption">Mindmap View</figcaption>
          </figure>
          <figure class="shot-slot">
            <img src="/images/one/screenshot-4.png" alt="Gmail Integration" />
            <figcaption class="shot-caption">Gmail Integration</figcaption>
          </figure>
        </div>
      </section>

      <!-- ── Tech Stack ── -->
      <section class="d-section d-stack">
        <p class="d-label">Tech Stack</p>
        <div class="stack-pills">
          {stack.map(t => <span class="stack-pill">{t}</span>)}
        </div>
      </section>

      <div class="d-bottom">
        <a href="/#projects" class="back-link">← Back to Projects</a>
      </div>

    </div>
  </div>
</Layout>

<style>
  /* ── Page ── */
  .detail-page {
    padding-top: 60px;
    padding-bottom: 80px;
  }

  /* ── Back link ── */
  .back-link {
    display: inline-block;
    font-size: 13px;
    color: var(--text-2);
    padding: 32px 0 0;
    transition: color 0.15s;
  }
  .back-link:hover {
    color: var(--text-1);
  }

  /* ── Hero ── */
  .d-hero {
    padding: 56px 0 48px;
    max-width: 660px;
  }
  .d-hero-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .beta-badge {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #93c5fd;
    border: 1px solid rgba(147, 197, 253, 0.2);
    background: rgba(147, 197, 253, 0.07);
    padding: 3px 10px;
    border-radius: 100px;
  }
  .product-cat {
    font-size: 13px;
    color: var(--text-2);
  }
  .d-hero-name {
    font-size: clamp(48px, 7vw, 72px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.05;
    margin-bottom: 14px;
  }
  .d-hero-tagline {
    font-size: 18px;
    color: var(--text-2);
    font-weight: 500;
    margin-bottom: 16px;
  }
  .d-hero-desc {
    font-size: 15px;
    color: var(--text-2);
    line-height: 1.8;
    max-width: 520px;
    margin-bottom: 28px;
  }
  .d-hero-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* ── Platform pills ── */
  .platform-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .platform-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-2);
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 6px 12px;
    border-radius: 100px;
  }

  /* ── Buttons ── */
  .btn {
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    font-weight: 500;
    padding: 10px 20px;
    border-radius: 8px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .btn-primary {
    background: #fff;
    color: #000;
    border-color: #fff;
  }
  .btn-primary:hover {
    opacity: 0.85;
  }

  /* ── Browser frame ── */
  .browser-frame {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 80px;
  }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  .bdot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    display: block;
  }
  .browser-body {
    position: relative;
  }
  :global(.browser-img) {
    width: 100%;
    display: block;
  }

  /* ── Image placeholder ── */
  .img-ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: var(--text-3);
    padding: 48px 24px;
    text-align: center;
  }
  .img-ph.large {
    padding: 96px 24px;
  }
  .img-ph p {
    font-size: 13px;
    color: var(--text-3);
  }
  .img-ph code {
    font-size: 11px;
    color: var(--text-3);
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: 4px;
    font-family: 'Menlo', 'Consolas', monospace;
  }

  /* ── Sections ── */
  .d-section {
    border-top: 1px solid var(--border);
    padding: 80px 0;
  }
  .d-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 12px;
  }
  .d-heading {
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 40px;
  }

  /* ── Features grid ── */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .feature-card {
    background: var(--surface);
    padding: 32px 28px;
    transition: background 0.15s;
  }
  .feature-card:hover {
    background: var(--surface-2);
  }
  .feature-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-hover);
    border-radius: 8px;
    color: var(--text-2);
    margin-bottom: 20px;
    flex-shrink: 0;
  }
  .feature-title {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }
  .feature-desc {
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.75;
  }
  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Screenshots grid ── */
  .screenshots-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .shot-slot {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .shot-slot .img-ph {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 40px 24px;
    flex: 1;
  }
  .shot-slot img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    display: block;
  }
  .shot-caption {
    font-size: 13px;
    color: var(--text-2);
    text-align: center;
  }
  @media (max-width: 860px) {
    .screenshots-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .screenshots-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Tech stack ── */
  .d-stack {
    padding-bottom: 0;
  }
  .stack-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .stack-pill {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-2);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 6px 14px;
    border-radius: 100px;
  }

  /* ── Bottom nav ── */
  .d-bottom {
    border-top: 1px solid var(--border);
    padding: 40px 0 0;
  }
  .d-bottom .back-link {
    padding-top: 0;
  }
</style>
